# Documentation template. Spring reads environment variables; it does not automatically read this file.
DB_URL=jdbc:mysql://localhost:3306/fuzzy_demo
DB_USER=fuzzy_app
DB_PASSWORD=replace-with-dedicated-database-password
FUZZY_DATA_ROOT=./data
FUZZY_DEMO=true
SERVER_ADDRESS=127.0.0.1
PORT=8080
COOKIE_SECURE=false
# For real OTP delivery: FUZZY_SMTP=true and SPRING_MAIL_HOST / PORT / USERNAME / PASSWORD
# Use STARTTLS via SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Outside an explicitly isolated educational hosted profile, keep demo mode off.
# For an authorized restricted hosted synthetic demo, use the hosted profile,
# a private FUZZY_SEED_PASSWORD, isolated persistent data and deployment/environment.example.
